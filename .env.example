# Supabase Postgres bağlantısı — Supabase Dashboard > Project Settings > Database >
# "Connection string" > "Transaction" (pgbouncer) modunu kullan.
# Örnek: postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# ("postgresql+psycopg://" — psycopg v3 sürücüsü kullanılıyor, requirements.txt'e bakın)
DATABASE_URL=

# `python -c "import secrets; print(secrets.token_urlsafe(48))"` ile üretilebilir.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# development | production
ENVIRONMENT=development
